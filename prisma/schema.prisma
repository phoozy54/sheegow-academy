// SHEEGOW ACADEMY - Prisma Schema
// Live English Learning Platform
// Uses PostgreSQL in production (Vercel + Neon) and locally.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USER ───────────────────────────────────────────────
model User {
  id             String   @id @default(cuid())
  fullName       String
  email          String   @unique
  /// Public login handle: 3-30 lowercase letters, digits, '.' or '_'.
  username       String?  @unique
  phone          String?
  password       String   // hashed with bcrypt
  role           String   @default("student") // "student" | "teacher" | "admin" | "super_admin"
  profilePicture String?
  bio            String?
  level          String   @default("Beginner") // Beginner | Intermediate | Advanced | IELTS | Kids
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  enrollments    Enrollment[]
  payments       Payment[]
  reviews        Review[]
  liveClasses    LiveClass[]
  messages       Message[]
  taughtCourses  Course[]
  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  submissions    Submission[]
  certificates   Certificate[]
  learningEvents LearningEvent[]
  pollVotes      PollVote[]
  attendances    Attendance[]
  bookmarks      Bookmark[]
  // New relations for e-learning features
  announcements Announcement[]
  threads       DiscussionThread[]
  replies       DiscussionReply[]
  conversationsAsUser1 Conversation[] @relation("ConversationUser1")
  conversationsAsUser2 Conversation[] @relation("ConversationUser2")
  directMessages DirectMessage[]
  lessonNotes   LessonNote[]
  // Wishlist / favorites — courses a student saved to enroll in later.
  wishlist      Wishlist[]
  // In-app notifications (announcements, replies, DMs, class reminders, etc.).
  notifications Notification[]
  // Refund requests submitted by this user (as student).
  refundRequests RefundRequest[]
  // Gamification: total points, day streak, and earned achievement badges.
  studentPoints StudentPoints?
  streak        Streak?
  badges        Badge[]
  // Teacher applications submitted by this user (as applicant).
  teacherApplications     TeacherApplication[] @relation("TeacherApplicationApplicant")
  // Teacher applications this user has reviewed (as admin/super_admin).
  reviewedApplications    TeacherApplication[] @relation("TeacherApplicationReviewer")
  // Affiliate / referral program — one code per user, plus the referrals they made.
  referralCode            ReferralCode?
  referralsMade           Referral[]           @relation("ReferralReferrer")
  // The referral record when THIS user signed up via someone else's code (one max).
  referredBy              Referral?            @relation("ReferralReferred")
}

// ─── TEACHER APPLICATIONS ─────────────────────────────────
// Students apply to become teachers by submitting an application with their
// qualifications. Admins review and approve (upgrading the user's role to
// "teacher") or reject. Mirrors the application flow on platforms like
// Udemy / Coursera / Teachable.
model TeacherApplication {
  id                 String   @id @default(cuid())
  applicantId        String   // the user applying
  fullName           String
  email              String
  phone              String
  city               String   // e.g. Hargeisa, Mogadishu, diaspora city
  country            String   // e.g. Somaliland, Somalia, UK, USA
  nativeLanguage     String   // e.g. Somali, Arabic
  englishLevel       String   // Beginner | Intermediate | Advanced | Native
  teachingExperience String   // "0" | "1-3" | "3-5" | "5-10" | "10+"
  certifications     String?  // TESOL, CELTA, degree, etc.
  bio                String   // professional bio (max 2000 chars)
  teachingPhilosophy String?  // why they want to teach
  sampleLesson       String?  // URL to a sample lesson/video
  linkedinUrl        String?
  resumeUrl          String?
  preferredCourses   String?  // what courses they'd like to teach
  availability       String   // "Weekday mornings", "Weekend evenings", etc.
  status             String   @default("pending") // pending | under_review | approved | rejected
  adminNote          String?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  applicant  User  @relation("TeacherApplicationApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  reviewer   User? @relation("TeacherApplicationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([applicantId])
}

// ─── COURSE ─────────────────────────────────────────────
model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  level       String   // Beginner | Intermediate | Advanced | IELTS | Kids
  price       Float
  duration    Int      // weeks
  image       String?
  teacherId   String?
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  whatYouLearn String? // newline separated bullet points
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Course prerequisite — students must complete this course first.
  prerequisiteCourseId String?

  teacher          User?         @relation(fields: [teacherId], references: [id])
  enrollments      Enrollment[]
  liveClasses      LiveClass[]
  reviews          Review[]
  payments         Payment[]
  modules          Module[]
  materials        Material[]
  quizzes          Quiz[]
  assignments      Assignment[]
  certificates     Certificate[]
  // New relations for e-learning features
  announcements Announcement[]
  threads       DiscussionThread[]
  // Wishlist / favorites — students who saved this course for later.
  wishlistItems Wishlist[]
  // Bundle membership — courses grouped into a discounted package.
  bundleItems  BundleCourse[]
  // Self-relation for course prerequisites — Course A must be completed
  // before a student can enroll in Course B.
  prerequisiteCourse Course?  @relation("CoursePrerequisite", fields: [prerequisiteCourseId], references: [id])
  prerequisiteFor    Course[] @relation("CoursePrerequisite")
}

// ─── ENROLLMENT ─────────────────────────────────────────
model Enrollment {
  id               String   @id @default(cuid())
  studentId        String
  courseId         String
  paymentId        String?  @unique
  progress         Int      @default(0) // 0-100
  completedLessons String   @default("") // comma separated lesson indices
  status           String   @default("active") // active | completed
  enrolledAt       DateTime @default(now())
  expiresAt        DateTime?
  completedAt      DateTime?

  student  User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payment  Payment? @relation(fields: [paymentId], references: [id])
  @@unique([studentId, courseId])
}

// ─── LIVE CLASS ────────────────────────────────────────
model LiveClass {
  id           String   @id @default(cuid())
  courseId     String?
  teacherId    String?
  title        String
  description  String?
  scheduledAt  DateTime
  duration     Int      @default(60) // minutes
  meetingLink  String?
  status       String   @default("scheduled") // scheduled | live | ended
  attendeeCount Int     @default(0)
  createdAt    DateTime @default(now())

  course     Course? @relation(fields: [courseId], references: [id])
  teacher    User?   @relation(fields: [teacherId], references: [id])
  messages   Message[]
  quizzes    Quiz[]
  polls      Poll[]
  attendances Attendance[]
}

// ─── PAYMENT ───────────────────────────────────────────
model Payment {
  id            String   @id @default(cuid())
  studentId     String
  courseId      String?
  amount        Float
  method        String   // "card" | "zaad" | "edahab"
  status        String   @default("pending") // pending | completed | failed
  transactionId String?
  couponCode    String?
  createdAt     DateTime @default(now())

  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course      Course?      @relation(fields: [courseId], references: [id])
  enrollment  Enrollment?
  // Refund requests tied to this payment (one pending/approved at a time).
  refundRequest RefundRequest?
}

// ─── REVIEW ────────────────────────────────────────────
model Review {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  rating    Int      // 1-5
  comment   String
  createdAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

// ─── MESSAGE (live class chat) ─────────────────────────
model Message {
  id        String   @id @default(cuid())
  classId   String
  senderId  String
  text      String
  createdAt DateTime @default(now())

  liveClass LiveClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// ─── CONTACT MESSAGE ───────────────────────────────────
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── COUPON ────────────────────────────────────────────
model Coupon {
  id        String   @id @default(cuid())
  code      String   @unique
  discount  Float    // percentage 0-100
  active    Boolean  @default(true)
  expiresAt DateTime?
  createdAt DateTime @default(now())
}

// ─── CONTENT FOUNDATION (modules → lessons → materials) ──
// Course metadata alone cannot deliver a learning experience. These models
// hold the ordered curriculum, private media/PDF references and per-lesson
// progress. Enrollment.progress remains a cached roll-up of LessonProgress.

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, order])
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  title       String
  // "video" | "pdf" | "text" | "quiz" | "live" | "assignment"
  type        String
  order       Int
  body        String?  // text/notes/summary shown in the player
  videoUrl    String?  // private/signed media URL — never a public bucket URL
  durationSec Int?
  isPreview   Boolean  @default(false) // visible before enrollment
  isPublished Boolean  @default(false)
  // Drip content — when set, the lesson is locked until this date.
  // When null, the lesson is immediately available.
  unlockAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module     Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  materials  Material[]
  progress   LessonProgress[]
  quiz       Quiz?
  assignment Assignment?
  bookmarks  Bookmark[]
  threads    DiscussionThread[]
  notes      LessonNote[]

  @@unique([moduleId, order])
}

model Material {
  id        String   @id @default(cuid())
  courseId  String
  lessonId  String?
  name      String
  url       String   // Cloudinary secure_url (private/signed delivery)
  mimeType  String
  sizeBytes Int?
  uploadedBy String?
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
}

model LessonProgress {
  id             String    @id @default(cuid())
  studentId      String
  lessonId       String
  status         String    @default("not_started") // not_started | in_progress | completed
  lastPositionSec Int      @default(0)
  secondsWatched Int       @default(0)
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

// ─── ASSESSMENT (quiz / test / homework) ─────────────────
model Quiz {
  id           String    @id @default(cuid())
  courseId     String
  lessonId     String?   @unique // one quiz per lesson
  liveClassId  String?   // set for a live quiz/poll-driven test
  title        String
  description  String?
  timeLimitSec Int?
  passScore    Int       @default(70) // percentage required to pass
  maxAttempts  Int       @default(3)
  randomize    Boolean   @default(true)
  isLive       Boolean   @default(false)
  isPublished  Boolean   @default(false)
  createdAt    DateTime  @default(now())

  course     Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson     Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  liveClass  LiveClass?    @relation(fields: [liveClassId], references: [id], onDelete: SetNull)
  questions  Question[]
  attempts   QuizAttempt[]
}

model Question {
  id       String @id @default(cuid())
  quizId   String
  type     String // single | multiple | true_false | short
  prompt   String
  points   Int    @default(1)
  order    Int

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  choices Choice[]
  answers QuizAnswer[]
}

model Choice {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false) // NEVER sent to the browser before submit
  order      Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  studentId   String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Int?      // percentage 0-100
  passed      Boolean?

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([studentId, quizId])
}

model QuizAnswer {
  id         String @id @default(cuid())
  attemptId  String
  questionId String
  choiceIds  String? // JSON array of Choice ids for single/multiple
  textAnswer String? // for short answers (manual grading later)
  isCorrect  Boolean?
  pointsEarned Int    @default(0)

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model Assignment {
  id           String    @id @default(cuid())
  courseId     String
  lessonId     String?   @unique // one homework assignment per lesson
  title        String
  instructions String
  dueAt        DateTime?
  maxPoints    Int       @default(100)
  isPublished  Boolean   @default(false)
  createdAt    DateTime  @default(now())

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  submissions Submission[]
}

model Submission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  note         String?
  fileUrl      String?   // signed upload URL
  submittedAt  DateTime  @default(now())
  status       String    @default("submitted") // submitted | graded | returned
  grade        Int?
  feedback     String?
  gradedBy     String?   // admin/teacher user id
  gradedAt     DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

// ─── CERTIFICATES & ANALYTICS ────────────────────────────
model Certificate {
  id               String    @id @default(cuid())
  studentId        String
  courseId         String
  serial           String    @unique
  verificationCode String    @unique
  issuedAt         DateTime  @default(now())
  revokedAt        DateTime?
  pdfUrl           String?

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model LearningEvent {
  id         String   @id @default(cuid())
  userId     String
  verb       String   // viewed | completed | attempted | passed | submitted
  objectType String   // lesson | quiz | assignment | class
  objectId   String
  courseId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── LIVE INTERACTION ────────────────────────────────────
model Poll {
  id          String    @id @default(cuid())
  liveClassId String
  question    String
  options     Json      // string[] shown to students
  createdBy   String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  liveClass LiveClass  @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  votes     PollVote[]
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  studentId String
  optionIndex Int
  createdAt DateTime @default(now())

  poll    Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([pollId, studentId])
}

model Attendance {
  id          String    @id @default(cuid())
  liveClassId String
  studentId   String
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  minutes     Int       @default(0)

  liveClass LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([liveClassId, studentId])
}

model Bookmark {
  id          String   @id @default(cuid())
  studentId   String
  lessonId    String
  note        String?
  positionSec Int?
  createdAt   DateTime @default(now())

  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

// ─── ANNOUNCEMENT ───────────────────────────────────────
// Teachers/admins post announcements visible to enrolled students.
model Announcement {
  id          String   @id @default(cuid())
  courseId    String
  authorId    String
  title       String
  body        String
  createdAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// ─── DISCUSSION / Q&A ────────────────────────────────────
// Students ask questions about a course (optionally tied to a lesson).
model DiscussionThread {
  id          String   @id @default(cuid())
  courseId    String
  lessonId    String?
  studentId   String
  title       String
  body        String
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson  Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  replies DiscussionReply[]
}

model DiscussionReply {
  id          String   @id @default(cuid())
  threadId    String
  authorId    String
  body        String
  createdAt   DateTime @default(now())

  thread DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// ─── DIRECT MESSAGING ───────────────────────────────────
// Private 1-to-1 conversations between any two users.
model Conversation {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1 User @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([user1Id, user2Id])
}

model DirectMessage {
  id             String    @id @default(cuid())
  conversationId  String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// ─── STUDENT NOTES ───────────────────────────────────────
// Personal notes a student takes while studying a lesson.
model LessonNote {
  id          String   @id @default(cuid())
  studentId   String
  lessonId    String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

// ─── WISHLIST / FAVORITES ─────────────────────────────────
// Courses a student saved to enroll in later. Stored per-user so it syncs
// across devices. One row per (student, course).
model Wishlist {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

// ─── NOTIFICATIONS ──────────────────────────────────────
// In-app notifications delivered to a single user. type discriminates the
// icon/colour and the link target. readAt is null until the user opens it.
model Notification {
  id        String   @id @default(cuid())
  userId    String   // recipient
  type      String   // "announcement" | "reply" | "message" | "class" | "system"
  title     String
  body      String
  link      String?  // URL to navigate to when clicked
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── COURSE BUNDLES ─────────────────────────────────────
// A bundle is a discounted package of multiple courses. Students buy the
// bundle once and are auto-enrolled in every included course. The price is
// typically lower than the sum of the individual course prices.

model Bundle {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     BundleCourse[]
}

model BundleCourse {
  id        String @id @default(cuid())
  bundleId  String
  courseId  String
  bundle    Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([bundleId, courseId])
}

// ─── REFUND REQUESTS ─────────────────────────────────────
// A student asks for their money back on a completed payment. An admin
// reviews it and either approves (the linked payment flips to "refunded"
// and the student is notified) or rejects. Only one pending/approved refund
// can exist per payment — a duplicate POST is rejected client-side.
model RefundRequest {
  id          String   @id @default(cuid())
  paymentId   String   @unique
  studentId   String
  reason      String
  status      String   @default("pending") // "pending" | "approved" | "rejected"
  adminNote   String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  payment  Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  student  User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([status, createdAt])
}

// ─── GAMIFICATION ──────────────────────────────────────────
// Points reward concrete learning actions (lessons, quizzes, attendance...),
// streaks track consecutive days of activity, and badges are one-time awards
// for milestones (first lesson, 7-day streak, etc.).

model StudentPoints {
  id        String  @id @default(cuid())
  studentId String  @unique
  points    Int     @default(0)
  student   User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Streak {
  id            String    @id @default(cuid())
  studentId     String    @unique
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastActiveDate DateTime?
  student       User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Badge {
  id        String   @id @default(cuid())
  studentId String
  // first_lesson | first_course | streak_7 | streak_30 | quiz_master |
  // social_butterfly | early_bird | night_owl | polyglot | perfect_attendance
  badgeType String
  awardedAt DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, badgeType])
}

// ─── AFFILIATE / REFERRAL PROGRAM ──────────────────────────────
// Every user can claim a unique referral code (e.g. "AHMED10"). When a new
// student signs up via a referral link (?ref=CODE) or applies the code in
// their dashboard, they get a one-time discount coupon and the referrer
// accumulates successful referrals (used to compute the "discount earned"
// stat shown on their dashboard widget).

model ReferralCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String   @unique // e.g. "AHMED10"
  discount  Float    @default(10) // percentage discount for the referred person
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String   // the person who shared the code
  referredId String   @unique // the person who used the code
  code       String
  createdAt  DateTime @default(now())

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId, createdAt])
}
