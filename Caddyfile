# ARCHIVED — NON-CANONICAL (DEP-1, 2026-11-28)
# Official production architecture: Vercel (Next.js app) + Neon Postgres +
# Render (chat service only). This self-host reverse proxy is kept for reference
# only and MUST NOT be used for sheegowacademy.com. Do not delete — archived.
:81 {
        # Never proxy to an arbitrary port supplied by a caller — that would
        # expose any internal service listening on localhost (SSRF pivot).
        @to_app {
                query XTransformPort=3002
        }
        @to_chat {
                query XTransformPort=3003
        }

        handle @to_app {
                reverse_proxy localhost:3002 {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                }
        }

        handle @to_chat {
                reverse_proxy localhost:3003 {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                }
        }

        handle {
                reverse_proxy localhost:3002 {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                }
        }
}
