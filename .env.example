# ─── SHEEGOW ACADEMY — Environment Variables ───────────────
# Copy this file to .env and fill in your values.

# Database (SQLite local file)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Auth secrets — generate strong random strings for production!
# Run: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret
JWT_REFRESH_SECRET=change-this-to-another-long-random-secret

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3002

# ─── Live Video (optional — for production live classes) ──
# Agora.io SDK (https://agora.io)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ─── Payments (optional — for production checkout) ────────
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# EVC Plus / Zaad (Hormuud / Somtel merchant credentials)
EVC_PLUS_MERCHANT_ID=
EVC_PLUS_API_KEY=
ZAAD_MERCHANT_ID=
ZAAD_API_KEY=

# ─── Email (optional — for notifications) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=hello@sheegow.academy

# ─── File storage (optional — for uploads) ────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Chat service port (socket.io mini-service) ───────────
CHAT_SERVICE_PORT=3003
