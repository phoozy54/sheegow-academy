# ─── SHEEGOW ACADEMY — Environment Variables ───────────────
# Copy this file to .env and fill in your values.

# Database (PostgreSQL in production — Neon, Supabase, Railway, etc.)
# Local dev:   "postgresql://user:pass@localhost:5432/sheegow"
# Neon free:   "postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/sheegow?sslmode=require"
DATABASE_URL=postgresql://user:pass@localhost:5432/sheegow

# Auth secrets — REQUIRED in production. If missing, the app fails closed.
# Generate each with: openssl rand -hex 32
# JWT_SECRET must be set to the SAME value on the chat service (Render).
JWT_SECRET=change-this-to-a-long-random-secret
JWT_REFRESH_SECRET=change-this-to-another-long-random-secret

# Super admin password — REQUIRED when seeding in production.
# Run "bun run db:superadmin" after deploy; it also rotates an existing password.
SUPER_ADMIN_PASSWORD=change-this-to-a-strong-password

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3002
# Chat service CORS allowlist (comma-separated). Defaults to the academy domain.
APP_ORIGIN=https://sheegowacademy.com,https://www.sheegowacademy.com

# ─── Chat service URL (production) ───────────────────────
# Set this in Vercel to your Render chat service URL (https://... required).
# It carries chat AND WebRTC signaling for live video.
# If left empty in production, https://sheegow-chat.onrender.com is used.
# Leave blank in dev (the app uses the Caddy gateway automatically).
NEXT_PUBLIC_CHAT_URL=

# ─── Live video (WebRTC) — optional TURN server ──────────
# Public STUN servers are used by default and work on most networks.
# For restrictive NAT, set a coturn TURN server here. These are SERVER-side
# secrets: the app mints short-lived credentials via /api/rtc/ice. Never use
# NEXT_PUBLIC_TURN_* — those values would be exposed in the browser bundle.
TURN_URL=
TURN_SECRET=

# ─── Demo mode ───────────────────────────────────────────
# The mock checkout creates "completed" payments with no real charge. It is
# only enabled in local dev or when explicitly set to true here. Keep FALSE
# in production until a real payment provider + signed webhook is integrated.
DEMO_MODE=false

# ─── Payments (optional — for production checkout) ────────
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mobile wallet merchant credentials (Telesom Zaad / E-Dahab).
# Cards use the Stripe keys above.
ZAAD_MERCHANT_ID=
ZAAD_API_KEY=
EDAHAB_MERCHANT_ID=
EDAHAB_API_KEY=

# ─── Email (optional — for notifications) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=hello@sheegow.academy

# ─── File storage (optional — for uploads) ────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Chat service port (local dev only) ───────────────────
CHAT_SERVICE_PORT=3003

# ─── Logging ──────────────────────────────────────────────
# Chat service log level: "quiet" (errors only), "" (default info), "debug" (verbose)
LOG_LEVEL=
